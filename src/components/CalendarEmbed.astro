---
interface Props {
  src: string;
  color?: string;
  title?: string;
  mode?: 'agenda' | 'MONTH' | 'WEEK';
  tall?: boolean;
}

const {
  src,
  color = '%237bd148',
  title = 'Calendar',
  mode = 'agenda',
  tall = false,
} = Astro.props;

const embedUrl =
  `https://www.google.com/calendar/embed?src=${encodeURIComponent(src)}` +
  `&color=${color}&mode=${mode}&showTitle=0&showPrint=0&showTabs=0&showCalendars=0&showTz=0`;
---

<iframe
  class:list={['embed-frame', { 'embed-frame--tall': tall }]}
  src={embedUrl}
  title={title}
  loading="lazy"
  referrerpolicy="no-referrer-when-downgrade"
></iframe>
