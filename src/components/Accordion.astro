---
type Item = {
  title: string;
  subtitle?: string;
  html?: string;
  open?: boolean;
};

interface Props {
  items: Item[];
  name?: string;
}

const { items, name = 'accordion' } = Astro.props;
---

<div class="accordion" data-accordion={name}>
  {
    items.map((item) => (
      <details class="accordion__item" open={item.open}>
        <summary class="accordion__summary">
          <span class="accordion__title">{item.title}</span>
          {item.subtitle && <span class="accordion__subtitle">{item.subtitle}</span>}
          <span class="accordion__icon" aria-hidden="true" />
        </summary>
        <div class="accordion__body prose" set:html={item.html ?? ''} />
      </details>
    ))
  }
</div>

<style>
  .accordion {
    display: grid;
    gap: 0.75rem;
  }

  .accordion__item {
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(7, 140, 140, 0.14);
    overflow: hidden;
    transition:
      border-color 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }

  .accordion__item[open] {
    border-color: rgba(7, 140, 140, 0.35);
    box-shadow: var(--shadow-soft);
  }

  .accordion__summary {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem 1rem;
    align-items: center;
    padding: 1rem 1.15rem;
    cursor: pointer;
    list-style: none;
  }

  .accordion__summary::-webkit-details-marker {
    display: none;
  }

  .accordion__title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--color-ink);
  }

  .accordion__subtitle {
    grid-column: 1;
    color: var(--color-teal);
    font-size: 0.92rem;
  }

  .accordion__icon {
    grid-row: 1 / span 2;
    width: 0.7rem;
    height: 0.7rem;
    border-right: 2px solid var(--color-teal);
    border-bottom: 2px solid var(--color-teal);
    transform: rotate(45deg);
    transition: transform 0.25s var(--ease-out);
  }

  .accordion__item[open] .accordion__icon {
    transform: rotate(225deg);
  }

  .accordion__body {
    padding: 0 1.15rem 1.15rem;
    color: var(--color-ink-soft);
  }

  .accordion__body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
