---
import BaseLayout from '../layouts/BaseLayout.astro';
import UpcomingEvents from '../components/UpcomingEvents.astro';
import PastEvents from '../components/PastEvents.astro';
import Link from '../components/Link.astro';
import { links } from '../content/links';
---

<BaseLayout
  title="Events"
  description="Upcoming Unity Fusion socials, workshops, and past monthly dances in Eugene."
>
  <section class="section">
    <div class="container">
      <p class="section__eyebrow">Unity Fusion Dancing</p>
      <h1 class="section__title">Events</h1>
      <p class="section__lead">
        Unity Fusion holds frequent social dance events throughout the year. Monthly events are
        typically planned for the 1st Saturday of the month.
        <Link href={links.subscribe}>Subscribe to our email list</Link>
        or follow us on
        <Link href={links.facebook}>Facebook</Link>
        to stay up to date. Learn more in our
        <Link href="/faq/" space="before">FAQ</Link>.
      </p>
    </div>
  </section>

  <UpcomingEvents />
  <section class="section">
    <div class="container">
      <p class="section__lead">
        Looking back?
        <Link href="/past-events/" space="before">View past events</Link>.
      </p>
    </div>
  </section>
</BaseLayout>
