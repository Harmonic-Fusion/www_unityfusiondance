---
import { nav } from '../content/links';

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="site-header__brand" href="/">
      <img
        src="/assets/images/logo-transparent.png"
        alt=""
        width="48"
        height="48"
        class="site-header__logo"
      />
      <span class="brand">Unity Fusion</span>
    </a>

    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="visually-hidden">Menu</span>
      <span class="site-header__burger" aria-hidden="true"></span>
    </button>

    <nav class="site-header__nav" id="site-nav" data-nav>
      <ul>
        {
          nav.map((item) => {
            const active =
              item.href === '/'
                ? pathname === '/' || pathname === '/home/'
                : pathname.startsWith(item.href);
            return (
              <li>
                <a href={item.href} aria-current={active ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');
  if (toggle instanceof HTMLButtonElement && nav instanceof HTMLElement) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      nav.classList.toggle('is-open', !open);
      document.body.classList.toggle('nav-open', !open);
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        nav.classList.remove('is-open');
        document.body.classList.remove('nav-open');
      });
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    backdrop-filter: blur(14px);
    background: rgba(247, 251, 251, 0.86);
    border-bottom: 1px solid rgba(7, 140, 140, 0.12);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-ink);
    text-decoration: none;
  }

  .site-header__brand:hover {
    color: var(--color-teal);
  }

  .site-header__logo {
    width: 2.75rem;
    height: 2.75rem;
    object-fit: contain;
  }

  .site-header__brand .brand {
    font-size: 1.35rem;
  }

  .site-header__toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 999px;
    background: rgba(139, 209, 217, 0.35);
    cursor: pointer;
  }

  .site-header__burger,
  .site-header__burger::before,
  .site-header__burger::after {
    display: block;
    width: 1.15rem;
    height: 2px;
    margin: 0 auto;
    background: var(--color-ink);
    transition: transform 0.25s var(--ease-out), opacity 0.2s;
  }

  .site-header__burger {
    position: relative;
  }

  .site-header__burger::before,
  .site-header__burger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .site-header__burger::before {
    top: -6px;
  }

  .site-header__burger::after {
    top: 6px;
  }

  .site-header__toggle[aria-expanded='true'] .site-header__burger {
    background: transparent;
  }

  .site-header__toggle[aria-expanded='true'] .site-header__burger::before {
    top: 0;
    transform: rotate(45deg);
  }

  .site-header__toggle[aria-expanded='true'] .site-header__burger::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .site-header__nav ul {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__nav a {
    display: inline-block;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    color: var(--color-ink-soft);
    font-family: var(--font-display);
    font-size: 1rem;
    text-decoration: none;
    transition:
      background 0.2s var(--ease-out),
      color 0.2s var(--ease-out);
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current='page'] {
    background: rgba(139, 209, 217, 0.35);
    color: var(--color-teal-deep);
  }

  @media (max-width: 860px) {
    .site-header__toggle {
      display: inline-grid;
      place-items: center;
    }

    .site-header__nav {
      position: fixed;
      inset: var(--header-h) 0 auto 0;
      max-height: 0;
      overflow: hidden;
      background: rgba(247, 251, 251, 0.97);
      border-bottom: 1px solid transparent;
      transition:
        max-height 0.35s var(--ease-out),
        border-color 0.2s;
    }

    .site-header__nav.is-open {
      max-height: 22rem;
      border-bottom-color: rgba(7, 140, 140, 0.12);
    }

    .site-header__nav ul {
      flex-direction: column;
      align-items: stretch;
      padding: 0.75rem 1rem 1.25rem;
      gap: 0.25rem;
    }

    .site-header__nav a {
      padding: 0.85rem 1rem;
    }
  }
</style>
