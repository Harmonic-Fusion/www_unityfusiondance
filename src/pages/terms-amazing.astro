---
import BaseLayout from '../layouts/BaseLayout.astro';
import DocEmbed from '../components/DocEmbed.astro';
import Link from '../components/Link.astro';
import { links } from '../content/links';
---

<BaseLayout
  title="Terms Amazing Weekend"
  description="Liability waiver and photo release for the Amazing Weekender event."
>
  <section class="section">
    <div class="container">
      <p class="section__eyebrow">Amazing Weekender</p>
      <h1 class="section__title">Terms Amazing Weekend</h1>
      <p class="section__lead">
        Unity Fusion + Dance Ninjas Weekend Terms. Questions?
        <Link href={links.mailto} space="before">unityfusiondance@gmail.com</Link>
      </p>
      <DocEmbed src={links.termsAmazing} title="Amazing Weekender Terms" />
      <p style="margin-top: 1.25rem">
        <Link href="/amazing/" space={false}>Back to Amazing Weekender</Link>
      </p>
    </div>
  </section>
</BaseLayout>
