---
import BaseLayout from "../layouts/BaseLayout.astro";
import PastEvents from "../components/PastEvents.astro";
import Link from "../components/Link.astro";
import { links } from "../content/links";
---

<BaseLayout
  title="Past Events"
  description="A look back at Unity Fusion socials, workshops, and special gatherings in Eugene."
>
  <section class="section section--tight">
    <div class="container">
      <p class="section__eyebrow">Unity Fusion Dancing</p>
      <h1 class="section__title">Past events</h1>
      <p class="section__lead">
        A look back at recent monthly socials and special gatherings.
        <Link href={links.subscribe}>Subscribe to our email list</Link>
        or follow us on
        <Link href={links.facebook}>Facebook</Link>
        to stay up to date.
      </p>
    </div>
  </section>

  <PastEvents showHeading={false} />

  <section class="section">
    <div class="container">
      <p class="section__lead">
        Looking for what is next?
        <Link href="/events/" space="before">View upcoming events</Link>.
      </p>
    </div>
  </section>
</BaseLayout>
