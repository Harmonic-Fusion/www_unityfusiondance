---
import Button from './Button.astro';
import { links } from '../content/links';

type Variant = 'solid' | 'outline' | 'ghost';

interface Props {
  variant?: Variant;
  class?: string;
}

const { variant = 'solid', class: className } = Astro.props;
---

<Button href={links.subscribe} variant={variant} class={['subscribe-button', className].filter(Boolean).join(' ')}>
  <svg
    class="subscribe-button__icon"
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <rect x="2" y="4" width="20" height="16" rx="2" />
    <path d="m22 7-10 6L2 7" />
  </svg>
  <span>Subscribe</span>
</Button>

<style>
  .subscribe-button__icon {
    flex-shrink: 0;
    width: 1.15em;
    height: 1.15em;
  }
</style>
