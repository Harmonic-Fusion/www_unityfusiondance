---
import BaseLayout from '../layouts/BaseLayout.astro';
import UpcomingEvents from '../components/UpcomingEvents.astro';
import PastEvents from '../components/PastEvents.astro';
import { links } from '../content/links';
---

<BaseLayout
  title="Events"
  description="Upcoming Unity Fusion socials, workshops, and past monthly dances in Eugene."
>
  <section class="section">
    <div class="container">
      <p class="section__eyebrow">Unity Fusion Dancing</p>
      <h1 class="section__title">Events</h1>
      <p class="section__lead">
        Unity Fusion holds frequent social dance events throughout the year. Monthly events are
        typically planned for the 1st Saturday of the month.
        <a href={links.subscribe} target="_blank" rel="noopener noreferrer">Subscribe to our email list</a>
        or follow us on
        <a href={links.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
        to stay up to date. Learn more in our <a href="/faq/">FAQ</a>.
      </p>
    </div>
  </section>

  <UpcomingEvents />
  <PastEvents />
</BaseLayout>
