---
import Accordion from "./Accordion.astro";
import { pastEvents, type PastEvent } from "../content/past-events";

interface Props {
  events?: PastEvent[];
}

const { events = pastEvents } = Astro.props;

const defaultBody =
  "Typical night: 7–8 pm lesson, 8–10:30 pm dancing. Sliding scale around $14/person.";

const accordionItems = events.map((event) => {
  const parts: string[] = [];
  if (event.body) {
    parts.push(
      ...event.body
        .trim()
        .split(/\n\n+/)
        .map((p) => `<p>${p.replace(/\n/g, "<br />")}</p>`),
    );
  }
  if (event.facebook) {
    parts.push(
      `<p><a href="${event.facebook}" target="_blank" rel="noopener noreferrer">Facebook event</a></p>`,
    );
  }
  if (!parts.length) {
    parts.push(`<p>${defaultBody}</p>`);
  }
  return {
    title: event.title,
    subtitle: event.date,
    html: parts.join(""),
  };
});
---

<section class="section">
  <div class="container">
    <Accordion items={accordionItems} name="past-events" />
  </div>
</section>
